{
  "entities": {
    "Group": {
      "title": "Group",
      "description": "A group of people sharing expenses",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the group"
        },
        "members": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of user IDs who are members of this group"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of creation"
        }
      },
      "required": ["name", "members", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "A user profile in a group",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "color": { "type": "string" },
        "avatarUrl": { "type": "string" }
      },
      "required": ["uid", "name", "color"]
    },
    "Expense": {
      "title": "Expense",
      "description": "An expense in a group",
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "paidById": { "type": "string" },
        "categoryId": { "type": "string" },
        "date": { "type": "string" },
        "splitMode": { "type": "string" },
        "isSettled": { "type": "boolean" },
        "involvedUserIds": { 
          "type": "array", 
          "items": { "type": "string" }
        },
        "createdAt": { "type": "string" }
      },
      "required": ["description", "amount", "paidById", "categoryId", "date", "splitMode", "involvedUserIds", "createdAt"]
    },
    "RecurringExpense": {
      "title": "RecurringExpense",
      "description": "A regular recurring fixed expense schedule",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "paidById": { "type": "string" },
        "categoryId": { "type": "string" },
        "frequency": { "type": "string" },
        "dayOfMonth": { "type": "number" },
        "involvedUserIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "description", "amount", "paidById", "categoryId", "frequency", "dayOfMonth", "involvedUserIds", "createdAt"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "Feedback from users",
      "type": "object",
      "properties": {
        "message": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["message", "createdAt"]
    }
  },
  "firestore": {
    "/feedback/{feedbackId}": {
      "schema": { "$ref": "#/entities/Feedback" },
      "description": "Submitted feedback"
    },
    "/groups/{groupId}": {
      "schema": { "$ref": "#/entities/Group" },
      "description": "The shared group"
    },
    "/groups/{groupId}/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Users inside the group"
    },
    "/groups/{groupId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Expenses belonging to the group"
    },
    "/groups/{groupId}/recurringExpenses/{recurringExpenseId}": {
      "schema": { "$ref": "#/entities/RecurringExpense" },
      "description": "Recurring regular expenses of the group"
    }
  }
}
